# -------------------------------------------------------------
# AI Travel Planner - Environment Variables Configuration
# Copy this file to .env.local and populate with your credentials
# -------------------------------------------------------------

# Step 2: OpenAI API (For AI itinerary generation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Step 3: Google Maps JavaScript API (For interactive maps & attractions)
# Get your key at: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Step 4: MongoDB Atlas Connection URI (To save & load user trips)
# Get your connection string at: https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-trip-planner?retryWrites=true&w=majority
